# Copy to .env (never commit .env). Missing keys fall back to the Day 6 starter/.env.

# LLM provider: openrouter (default) | gemini | openai | ollama
LLM_PROVIDER=openrouter
# Optional override of the provider's default model (openai/gpt-4o-mini, gemini-3.5-flash-lite, gpt-4o-mini, qwen2.5:7b)
LLM_MODEL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: price override in USD per 1M tokens when the provider does not report cost
LLM_PRICE_IN=
LLM_PRICE_OUT=

# Day 6 vector store (Postgres + pgvector, docker compose in the Day 6 starter)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
# Optional: location of the Day 6 starter folder
DAY6_STARTER=
# Optional: GitHub token for github_search (raises rate limit)
GITHUB_TOKEN=
